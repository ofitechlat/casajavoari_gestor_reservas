generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  role      String   @default("user") // admin, manager, user
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  bookings  Booking[]
}

model Space {
  id          String    @id @default(uuid())
  slug        String    @unique // sala-principal
  name        String
  description String?
  dimensions  String?
  type        String    // indoor, outdoor
  hourlyRate  Float
  color       String?
  mapConfig   String?   // JSON string containing x, y, width, height, path
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  bookings    Booking[]
}

model Booking {
  id           String    @id @default(uuid())
  title        String
  description  String?
  startTime    DateTime
  endTime      DateTime
  status       String    @default("pending") // pending, approved, rejected
  noiseLevel   String    @default("moderate")
  needsSilence Boolean   @default(false)
  exclusive    Boolean   @default(false)
  
  recurrence   String?   // JSON string describing recurrence pattern
  
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  
  spaceId      String
  space        Space     @relation(fields: [spaceId], references: [id]) // Use slug or id? keeping id for now

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Activity {
  id          String   @id @default(uuid())
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime? // For multi-day activities
  startTime   String?   // Store as "HH:mm"
  responsible String?
  imageUrl    String?   // Base64 or URL to compressed WebP
  videoUrl    String?   // YouTube link
  instagram   String?
  email       String?
  tags        String?   // comma-separated
  createdAt   DateTime @default(now())
}

model Venture {
  id          String   @id @default(uuid())
  name        String
  owner       String?
  description String?
  logoUrl     String?  // Base64 or URL to compressed WebP
  ownerImageUrl String? // Photo of the owner
  whatsapp    String?
  instagram   String?
  facebook    String?
  website     String?
  email       String?
  createdAt   DateTime @default(now())
  products    Product[]
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Float?   // Numeric value
  currency    String   @default("CRC") // CRC or USD
  category    String?  // e.g., Clothing, Food, etc.
  type        String   @default("product") // product or service
  size        String?  // e.g., S, M, L (for clothes)
  dimensions  String?  // e.g., 20x30cm
  imageUrl    String?  // Product photo (WebP)
  videoUrl    String?  // YouTube link
  ventureId   String
  venture     Venture  @relation(fields: [ventureId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}
