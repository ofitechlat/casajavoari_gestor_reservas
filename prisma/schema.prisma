generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Space {
  id          String    @id @default(uuid()) @db.Uuid
  slug        String    @unique
  name        String
  description String?
  capacity    Int?      // Added missing field
  dimensions  String?
  type        String    // indoor, outdoor
  hourlyRate  Float     @map("hourly_rate")
  color       String?
  image       String?   // Added missing field
  mapConfig   Json?     @map("map_config")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  
  bookings    Booking[]
  activities  Activity[] @relation("ActivitySpaces")

  @@map("spaces")
}

model Contact {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  email       String?
  phone       String?
  metadata    Json?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  
  bookings    Booking[]

  @@map("contacts")
}

model Booking {
  id           String    @id @default(uuid()) @db.Uuid
  title        String
  description  String?
  startTime    DateTime  @map("start_time")
  endTime      DateTime  @map("end_time")
  activityType String?   @map("activity_type") // Added missing field
  status       String    @default("pending")
  noiseLevel   String    @default("moderate") @map("noise_level")
  needsSilence Boolean   @default(false) @map("needs_silence")
  exclusive    Boolean   @default(false)
  adminNotes   String?   @map("admin_notes")   // Added missing field
  totalPrice   Float?    @map("total_price")   // Added missing field
  recurrence   Json?
  
  userId       String?   @db.Uuid @map("user_id")
  
  contactId    String?   @db.Uuid @map("contact_id")
  contact      Contact?  @relation(fields: [contactId], references: [id])

  spaceId      String    @db.Uuid @map("space_id")
  space        Space     @relation(fields: [spaceId], references: [id])

  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("bookings")
}

model Activity {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  description String?
  startDate   DateTime @map("start_date")
  endDate     DateTime? @map("end_date")
  startTime   String?   @map("start_time") // Store as "HH:mm"
  responsible String?
  imageUrl    String?   @map("image_url")
  videoUrl    String?   @map("video_url")
  instagram   String?   @map("instagram_handle")
  email       String?
  tags        String[]  // Array of strings in Postgres
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  spaces      Space[]   @relation("ActivitySpaces")

  @@map("activities")
}

model Venture {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  owner         String?
  description   String?
  logoUrl       String?  @map("logo_url")
  ownerImageUrl String?  @map("owner_image_url")
  whatsapp      String?
  instagram     String?
  facebook      String?
  website       String?
  email         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  
  products      Product[]

  @@map("ventures")
}

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String?
  price       Float?
  currency    String   @default("CRC")
  category    String?
  type        String   @default("product")
  size        String?
  dimensions  String?
  imageUrl    String?  @map("image_url")
  videoUrl    String?  @map("video_url")
  
  ventureId   String   @db.Uuid @map("venture_id")
  venture     Venture  @relation(fields: [ventureId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("products")
}
